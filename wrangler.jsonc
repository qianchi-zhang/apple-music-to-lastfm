{
  "name": "apple-music-scrobbler",
  "main": "apps/worker/src/production-entry.ts",
  "compatibility_date": "2026-09-08",
  "kv_namespaces": [
    { "binding": "ASCROBBLE_STATE", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SCROBBLE_COORDINATOR", "class_name": "ScrobbleCoordinator" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ScrobbleCoordinator"] },
  ],
  "triggers": { "crons": [] },
  "observability": { "enabled": true },
}
